{
  "AppSettings": {
    "SecretKey": "MySuperStrongJwtSecretKey_2026_ThisIsSafe123!",
    "Issuer": "MyWebApi",
    "Audience": "MyWebApi"
  },
  "ConnectionStrings": {
    // ⚙️ Đổi "Data Source" nếu SQL Server của bạn có tên instance khác:
    //   - (local)\SQLEXPRESS  → phổ biến nhất (máy cài SQL Server Express)
    //   - .\SQLEXPRESS        → tương tự dấu chấm thay (local)
    //   - localhost           → SQL Server Developer / không có instance name
    //   - TEN_MAY\SQLEXPRESS  → thay TEN_MAY bằng tên máy tính của bạn
    "DefaultConnection": "Data Source=(local)\\SQLEXPRESS;Initial Catalog=dbHeThongGioiThieuNguoiGiupViec;Integrated Security=True;Persist Security Info=False;Pooling=False;Multiple Active Result Sets=False;Encrypt=False;Trust Server Certificate=True;Command Timeout=0;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
